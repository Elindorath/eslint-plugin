{
  "name": "@elindorath/eslint-plugin",
  "version": "1.0.0",
  "description": "An Eslint plugin centralizing all the configurations I use",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintconfig",
    "eslintplugin"
  ],
  "homepage": "https://github.com/elindorath/eslint-plugin#readme",
  "bugs": "https://github.com/elindorath/eslint-plugin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elindorath/eslint-plugin.git"
  },
  "license": "MIT",
  "author": {
    "name": "Elindorath",
    "email": "Elindorath@users.noreply.github.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "./scripts/generate-meta.ts && tsc --project tsconfig.build.json",
    "extract-meta": "node scripts/extract-meta.ts",
    "lint": "NODE_OPTIONS='--experimental-require-module' eslint .",
    "lint:fix": "NODE_OPTIONS='--experimental-require-module' eslint --fix .",
    "prepack": "yarn run build",
    "spellcheck": "cspell lint --no-progress \"**\"",
    "test-build": "yarn run build && git diff --exit-code src/meta.ts",
    "test-reachability": "./scripts/test-reachability.ts",
    "test-schema": "./scripts/test-schema.ts",
    "test-update": "./scripts/test-update.ts",
    "type-check": "tsc"
  },
  "resolutions": {
    "@typescript-eslint/utils": "8.70.0"
  },
  "dependencies": {
    "@cspell/eslint-plugin": "10.3.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/compat": "2.1.1",
    "@eslint/css": "2.0.0",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.103.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-canonical": "5.1.3",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-filenames-simple": "0.9.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jest-extended": "3.0.1",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-listeners": "1.6.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-constructor-bind": "2.0.4",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-no-use-extend-native": "0.7.3",
    "eslint-plugin-package-json": "1.8.1",
    "eslint-plugin-perfectionist": "5.11.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-i18n": "1.0.3",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-react-perf": "3.3.3",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "is-what": "5.5.0",
    "read-package-up": "12.0.0",
    "type-fest": "5.10.0",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@cspell/cspell-types": "10.3.3",
    "@sidvind/better-ajv-errors": "3.0.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.13.6",
    "ajv": "6.12.6",
    "better-typescript-lib": "2.12.0",
    "case-anything": "3.1.3",
    "cspell": "10.3.3",
    "eslint": "10.11.0",
    "fs-extra": "11.4.0",
    "jiti": "2.7.0",
    "json-diff-ts": "4.10.4",
    "package-directory": "8.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.21.0"
  }
}
