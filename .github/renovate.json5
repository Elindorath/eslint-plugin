{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  assignees: [
    'Elindorath',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  labels: [
    'renovate',
  ],
  separateMultipleMajor: true,
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      matchDepTypes: [
        'dependencies',
      ],
      addLabels: [
        'dependencies',
      ],
    },
    {
      matchDepTypes: [
        'devDependencies',
      ],
      addLabels: [
        'dev-dependencies',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'patch',
      ],
    },
    {
      matchUpdateTypes: [
        'pin',
        'digest',
      ],
      addLabels: [
        'pin',
      ],
    },
    {
      matchPackageNames: [
        'ajv',
        '@sidvind/better-ajv-errors',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'cspell',
        '@cspell/**',
      ],
      groupName: 'cspell',
    },
    {
      matchPackageNames: [
        '@types/node',
        'eslint-plugin-unicorn',
      ],
      separateMultipleMajor: false,
    },
    {
      matchPackageNames: [
        'typescript-eslint',
      ],
      sourceDirectory: 'packages/eslint-plugin',
    },
    {
      matchDatasources: [
        'npm',
      ],
      minimumReleaseAge: '3 days',
    },
  ],
}
